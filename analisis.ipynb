   "source": [
    "import json\n",
    "import pandas as pd\n",
    "\n",
    "with open(\"3773631.json\", \"r\", encoding=\"utf-8\") as file:\n",
    "    events = json.load(file)\n",
    "\n",
    "df = pd.json_normalize(events)\n",
    "\n",
    "print(\"Filas:\", df.shape[0])\n",
    "print(\"Columnas:\", df.shape[1])\n",
    "\n",
    "df[[\"minute\", \"type.name\", \"team.name\", \"player.name\"]].head(10)"
   ]
  }
