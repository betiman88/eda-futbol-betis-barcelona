
import json
import os
import subprocess
import sys
from pathlib import Path

import pandas as pd
import requests


# ============================================================
# 1. CONFIGURACIÓN
# ============================================================

URL_COMPETICIONES = (
    "https://raw.githubusercontent.com/statsbomb/"
    "open-data/master/data/competitions.json"
)

URL_BASE = (
    "https://raw.githubusercontent.com/statsbomb/"
    "open-data/master/data"
)

# Carpeta raíz del proyecto
CARPETA_PROYECTO = Path(__file__).resolve().parent

# Carpetas de datos
CARPETA_RAW = CARPETA_PROYECTO / "data" / "raw"
CARPETA_PROCESADOS = CARPETA_PROYECTO / "data" / "processed"

# Script que prepara los datos para Power BI
SCRIPT_PREPARAR = (
    CARPETA_PROYECTO / "src" / "prepare_match.py"
)

# Informe de Power BI
ARCHIVO_POWERBI = (
    CARPETA_PROYECTO / "Dashboard Barcelona-Betis.pbix"
)

TIMEOUT = 60


# ============================================================
# 2. SELECCIONAR UNA OPCIÓN
# ============================================================

def seleccionar_opcion(
    datos,
    columna_nombre,
    columna_id,
    mensaje
):
    """Muestra opciones numeradas y devuelve la seleccionada."""

    if datos.empty:
        raise ValueError("No hay opciones disponibles.")

    for i, (_, fila) in enumerate(datos.iterrows(), start=1):
        print(
            f"{i}. {fila[columna_nombre]} "
            f"(ID: {fila[columna_id]})"
        )

    while True:
        try:
            seleccion = int(input(mensaje))

            if 1 <= seleccion <= len(datos):
                return datos.iloc[seleccion - 1]

            print(
                f"Introduce un número entre 1 y {len(datos)}."
            )

        except ValueError:
            print("Introduce un número entero válido.")


# ============================================================
# 3. DESCARGAR COMPETICIONES Y TEMPORADAS
# ============================================================

def cargar_competiciones():
    """Descarga el catálogo de competiciones de StatsBomb."""

    print("Descargando el catálogo de competiciones...")

    respuesta = requests.get(
        URL_COMPETICIONES,
        timeout=TIMEOUT
    )

    respuesta.raise_for_status()

    return pd.DataFrame(respuesta.json())


def elegir_competicion_y_temporada(df):
    """Permite seleccionar una competición y una temporada."""

    competiciones = (
        df[["competition_id", "competition_name"]]
        .drop_duplicates()
        .sort_values("competition_name")
        .reset_index(drop=True)
        .rename(
            columns={
                "competition_id": "id",
                "competition_name": "nombre"
            }
        )
    )

    print("\n" + "=" * 55)
    print("COMPETICIONES DISPONIBLES")
    print("=" * 55)

    competicion = seleccionar_opcion(
        competiciones,
        "nombre",
        "id",
        "\nSelecciona una competición: "
    )

    temporadas = (
        df.loc[
            df["competition_id"] == competicion["id"],
            ["season_id", "season_name"]
        ]
        .drop_duplicates()
        .sort_values("season_name", ascending=False)
        .reset_index(drop=True)
        .rename(
            columns={
                "season_id": "id",
                "season_name": "nombre"
            }
        )
    )

    print(
        f"\nTEMPORADAS DE {competicion['nombre']}"
    )

    temporada = seleccionar_opcion(
        temporadas,
        "nombre",
        "id",
        "\nSelecciona una temporada: "
    )

    return competicion, temporada


# ============================================================
# 4. DESCARGAR LOS PARTIDOS DE LA TEMPORADA
# ============================================================

def cargar_partidos(competition_id, season_id):
    """Obtiene los partidos disponibles de una temporada."""

    url = (
        f"{URL_BASE}/matches/"
        f"{competition_id}/{season_id}.json"
    )

    print("\nDescargando la lista de partidos...")

    respuesta = requests.get(
        url,
        timeout=TIMEOUT
    )

    respuesta.raise_for_status()

    datos = respuesta.json()

    return pd.json_normalize(datos, sep="_")


# ============================================================
# 5. SELECCIONAR UN PARTIDO
# ============================================================

def elegir_partido(partidos):
    """Muestra los partidos y permite elegir uno."""

    if partidos.empty:
        return None

    columnas = [
        "match_id",
        "match_date",
        "home_team_home_team_name",
        "away_team_away_team_name",
        "home_score",
        "away_score"
    ]

    faltantes = [
        columna
        for columna in columnas
        if columna not in partidos.columns
    ]

    if faltantes:
        raise ValueError(
            f"Faltan columnas en los partidos: {faltantes}"
        )

    partidos = (
        partidos[columnas]
        .sort_values("match_date")
        .reset_index(drop=True)
    )

    partidos["nombre"] = partidos.apply(
        lambda fila: (
            f"{fila['match_date']} | "
            f"{fila['home_team_home_team_name']} - "
            f"{fila['away_team_away_team_name']} | "
            f"{fila['home_score']} - "
            f"{fila['away_score']}"
        ),
        axis=1
    )

    partidos["id"] = partidos["match_id"]

    print("\n" + "=" * 55)
    print(f"PARTIDOS DISPONIBLES: {len(partidos)}")
    print("=" * 55)

    return seleccionar_opcion(
        partidos,
        "nombre",
        "id",
        "\nSelecciona un partido: "
    )


# ============================================================
# 6. MOSTRAR INFORMACIÓN DEL PARTIDO
# ============================================================

def mostrar_resultado(partido):
    """Muestra los datos básicos del encuentro."""

    print("\n" + "=" * 55)
    print("PARTIDO SELECCIONADO")
    print("=" * 55)

    print("Fecha:", partido["match_date"])

    print(
        "Encuentro:",
        partido["home_team_home_team_name"],
        "-",
        partido["away_team_away_team_name"]
    )

    print(
        "Resultado:",
        partido["home_score"],
        "-",
        partido["away_score"]
    )

    print("Match ID:", int(partido["match_id"]))


# ============================================================
# 7. GUARDAR INFORMACIÓN DEL PARTIDO PARA POWER BI
# ============================================================

def guardar_informacion_partido(partido):
    """
    Guarda los nombres de los equipos y el identificador
    del encuentro en un JSON que utilizaremos en Power BI.
    """

    CARPETA_PROCESADOS.mkdir(
        parents=True,
        exist_ok=True
    )

    informacion = {
        "match_id": int(partido["match_id"]),
        "fecha": str(partido["match_date"]),
        "equipo_local": str(
            partido["home_team_home_team_name"]
        ),
        "equipo_visitante": str(
            partido["away_team_away_team_name"]
        ),
        "goles_local": (
            int(partido["home_score"])
            if pd.notna(partido["home_score"])
            else None
        ),
        "goles_visitante": (
            int(partido["away_score"])
            if pd.notna(partido["away_score"])
            else None
        )
    }

    ruta_json = (
        CARPETA_PROCESADOS / "partido_actual.json"
    )

    with open(
        ruta_json,
        "w",
        encoding="utf-8"
    ) as archivo:
        json.dump(
            informacion,
            archivo,
            ensure_ascii=False,
            indent=4
        )

    print("\nInformación del partido guardada:")
    print(f"Archivo: {ruta_json}")
    print(f"Equipo local: {informacion['equipo_local']}")
    print(
        "Equipo visitante: "
        f"{informacion['equipo_visitante']}"
    )

    return ruta_json


# ============================================================
# 8. DESCARGAR LOS EVENTOS DEL PARTIDO
# ============================================================

def descargar_partido(match_id):
    """Descarga los eventos y guarda el JSON original."""

    url = f"{URL_BASE}/events/{match_id}.json"

    print("\nDescargando eventos del partido...")

    respuesta = requests.get(
        url,
        timeout=TIMEOUT
    )

    respuesta.raise_for_status()

    datos = respuesta.json()

    if not datos:
        raise ValueError(
            "El partido seleccionado no contiene eventos."
        )

    CARPETA_RAW.mkdir(
        parents=True,
        exist_ok=True
    )

    ruta_json = CARPETA_RAW / f"{match_id}.json"

    with open(
        ruta_json,
        "w",
        encoding="utf-8"
    ) as archivo:
        json.dump(
            datos,
            archivo,
            ensure_ascii=False
        )

    print(f"Eventos descargados: {len(datos)}")
    print(f"JSON guardado en: {ruta_json}")

    return ruta_json


# ============================================================
# 9. EJECUTAR LA PREPARACIÓN DE LOS CSV
# ============================================================

def preparar_datos_powerbi(match_id):
    """Ejecuta prepare_match.py para el partido seleccionado."""

    if not SCRIPT_PREPARAR.exists():
        raise FileNotFoundError(
            "No se encuentra el script de preparación: "
            f"{SCRIPT_PREPARAR}"
        )

    print("\nPreparando los datos para Power BI...")

    subprocess.run(
        [
            sys.executable,
            str(SCRIPT_PREPARAR),
            str(match_id)
        ],
        cwd=str(CARPETA_PROYECTO),
        check=True
    )

    csv_eventos = (
        CARPETA_PROCESADOS / "eventos_partido.csv"
    )

    csv_tiros = (
        CARPETA_PROCESADOS / "tiros_partido.csv"
    )

    if not csv_eventos.exists():
        raise FileNotFoundError(
            f"No se ha generado el archivo: {csv_eventos}"
        )

    if not csv_tiros.exists():
        raise FileNotFoundError(
            f"No se ha generado el archivo: {csv_tiros}"
        )

    print("\nCSV preparados correctamente:")
    print(f"Eventos: {csv_eventos}")
    print(f"Tiros:   {csv_tiros}")


# ============================================================
# 10. ABRIR POWER BI
# ============================================================

def abrir_powerbi():
    """Abre el informe de Power BI en Windows."""

    if not ARCHIVO_POWERBI.exists():
        raise FileNotFoundError(
            "No se encuentra el informe de Power BI: "
            f"{ARCHIVO_POWERBI}"
        )

    print("\nAbriendo el informe de Power BI...")

    os.startfile(str(ARCHIVO_POWERBI))


# ============================================================
# 11. FLUJO COMPLETO
# ============================================================

def procesar_partido(partido):
    """
    Descarga el partido, guarda sus metadatos,
    genera los CSV y abre Power BI.
    """

    match_id = int(partido["match_id"])

    # 1. Descargar los eventos originales
    descargar_partido(match_id)

    # 2. Guardar los nombres reales de ambos equipos
    guardar_informacion_partido(partido)

    # 3. Generar los CSV que consume Power BI
    preparar_datos_powerbi(match_id)

    # 4. Abrir el informe
    abrir_powerbi()


# ============================================================
# 12. PROGRAMA PRINCIPAL
# ============================================================

def main():
    """Punto de entrada del buscador."""

    try:
        df = cargar_competiciones()

        competicion, temporada = (
            elegir_competicion_y_temporada(df)
        )

        partidos = cargar_partidos(
            competicion["id"],
            temporada["id"]
        )

        if partidos.empty:
            print(
                "\nNo hay partidos disponibles "
                "para esta competición y temporada."
            )
            return

        partido = elegir_partido(partidos)

        if partido is None:
            print("\nNo se ha seleccionado ningún partido.")
            return

        mostrar_resultado(partido)

        procesar_partido(partido)

        print("\n" + "=" * 55)
        print("PROCESO COMPLETADO")
        print("=" * 55)
        print("Los datos del partido se han preparado.")
        print(
            "Si Power BI ya estaba abierto, "
            "actualiza el informe para cargar los CSV nuevos."
        )

    except requests.RequestException as error:
        print(
            "\nError de conexión o descarga:"
            f"\n{error}"
        )

    except subprocess.CalledProcessError as error:
        print(
            "\nError al ejecutar prepare_match.py."
            f"\nCódigo de salida: {error.returncode}"
        )

    except (
        KeyError,
        ValueError,
        FileNotFoundError,
        OSError
    ) as error:
        print(f"\nError durante la ejecución:\n{error}")


if __name__ == "__main__":
    main()
